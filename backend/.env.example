# ---------------------------------------------------------------------------------------------
# Price Tracker — backend environment
#
# Copy to `.env` and fill in. Every variable here has a working default EXCEPT the two secrets in
# the "Auth" block, so a fresh clone runs the price-comparison API with no configuration at all.
# ---------------------------------------------------------------------------------------------

# --- Server ------------------------------------------------------------------------------------
# Port the Express server listens on.
PORT=5000

# --- Auth (MongoDB) ------------------------------------------------------------------------------
# MongoDB backs ONLY the User and Role documents used by the auth routes. Price search touches
# neither, and `config/database.ts` fails open on purpose — leave these unset and search still
# works, only the auth routes stop.
MONGODB_URI=
# Signing key for auth tokens. Generate your own; never reuse one across environments.
JWT_SECRET=

# --- Redis (caching + sessions) -------------------------------------------------------------------
# Strongly recommended but not required: `services/keyValueCache.ts` falls back to an in-process map
# when Redis is unreachable, so the app keeps working and only loses caching across restarts.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Search behaviour ------------------------------------------------------------------------------
# How long a completed search is reused for the same query + location. Prices move slowly, and this
# is what turns a repeat search from ~45 s into ~0.7 s.
SEARCH_CACHE_TTL_SECONDS=300

# How long a minted platform session (cookies, WAF tokens, a bound delivery address) is reused.
# Binding an address is the slow part of a search, so this is paid once per location, not per query.
PLATFORM_SESSION_TTL_SECONDS=43200

# Default per-platform ceiling. Individual adapters override this where their own work is slower —
# the browser-driven ones declare their own `searchTimeoutMs`.
PLATFORM_SEARCH_TIMEOUT_MS=20000

# Comma-separated allow-list of platform ids to run, e.g. "blinkit,zepto".
# Leave blank to run every adapter whose `checkIfEnabled` is true.
# Valid ids: blinkit, zepto, swiggyInstamart, bigBasket, flipkartMinutes, amazonNow
PRICE_TRACKER_ENABLED_PLATFORM_ID_LIST=

# --- Outbound proxy ---------------------------------------------------------------------------------
# Applies to both impersonation clients (impit and CycleTLS). Leave unset for a direct connection.
#
# This exists because some platforms block the SOURCE ADDRESS rather than the client: measured
# 2026-10-25, BigBasket's own JavaScript gets HTTP 403 from BigBasket's own listing API inside real
# Chrome, which no client-side change can fix. Setting the BigBasket override below is the single
# thing that would bring BB Now back.
PRICE_TRACKER_PROXY_URL=

# Per-platform override, built as PRICE_TRACKER_<PLATFORM_ID_IN_UPPER_SNAKE_CASE>_PROXY_URL.
# It wins over PRICE_TRACKER_PROXY_URL for that one platform.
PRICE_TRACKER_BIGBASKET_PROXY_URL=
# PRICE_TRACKER_BLINKIT_PROXY_URL=
# PRICE_TRACKER_ZEPTO_PROXY_URL=
# PRICE_TRACKER_SWIGGY_INSTAMART_PROXY_URL=
# PRICE_TRACKER_FLIPKART_MINUTES_PROXY_URL=
# PRICE_TRACKER_AMAZON_NOW_PROXY_URL=

# --- Verification scripts ----------------------------------------------------------------------------
# Where `src/scripts/verifyLocationMatrix.ts` sends its requests. Only used by the scripts.
PRICE_TRACKER_SERVER_ORIGIN=http://localhost:5000
