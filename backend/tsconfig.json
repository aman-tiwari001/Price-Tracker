{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": []
  },
  "include": ["src/**/*.ts", ".eslintrc.js", ".prettierrc.js", "src/adapters/test.ts"],
  "exclude": ["node_modules"]
}
